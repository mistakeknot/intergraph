#!/usr/bin/env python3
"""intergraph CLI — ingest / query / export the Sylveste ecosystem graph."""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from intergraph import behavior, code, export, ingest, store  # noqa: E402


def portfolio_command(args):
    import os
    import sqlite3
    from contextlib import ExitStack, closing

    from intergraph import portfolio

    try:
        if args.db is not None:
            raise portfolio.PortfolioError("use --portfolio-db for the private store")
        if args.cmd == "portfolio-convert":
            from intergraph.portfolio_convert import convert

            prior = portfolio.loads(Path(args.sidecar).read_text(encoding="utf-8")) if args.sidecar else None
            inventory = Path(args.inventory).read_text(encoding="utf-8")
            manifest, sidecar, result = convert(inventory, args.observed_at, prior)
            outputs = (Path(args.output_manifest), Path(args.output_sidecar))
            if outputs[0].resolve() == outputs[1].resolve():
                raise portfolio.PortfolioError("conversion requires two distinct new output files")
            created = []
            try:
                with ExitStack() as stack:
                    for path, value in zip(outputs, (manifest, sidecar)):
                        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
                        created.append(path)
                        stream = stack.enter_context(os.fdopen(fd, "w", encoding="utf-8"))
                        json.dump(value, stream, indent=2, allow_nan=False)
                        stream.write("\n")
            except (ValueError, OSError):
                for path in created:
                    path.unlink(missing_ok=True)
                raise
        else:
            database = args.portfolio_db or portfolio.default_path()
            if args.cmd == "portfolio-import":
                document = portfolio.loads(Path(args.manifest).read_text(encoding="utf-8"))
                result = portfolio.import_document(database, document, args.expected_revision, args.dry_run)
            else:
                with closing(portfolio.open_readonly(database)) as con:
                    result = portfolio.export_archive(con)
        print(json.dumps(result, indent=2, allow_nan=False))
        return 0
    except portfolio.PortfolioError as error:
        print(error, file=sys.stderr)
    except (ValueError, TypeError, KeyError, OSError, sqlite3.DatabaseError):
        print("portfolio operation unavailable", file=sys.stderr)
    return 2


def main() -> int:
    ap = argparse.ArgumentParser(prog="intergraph")
    ap.add_argument("--db", help="SQLite db path (default: data/intergraph.db)")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p_ing = sub.add_parser("ingest", help="rebuild graph from interverse manifests")
    p_ing.add_argument("--root", help="interverse root (default: auto-detect)")
    p_ing.add_argument("--no-behavior", action="store_true",
                       help="skip session-history behavioral scan")
    p_ing.add_argument("--no-code", action="store_true",
                       help="skip code-level cross-plugin scan")

    sub.add_parser("stats", help="node/edge counts")
    sub.add_parser("export", help="interchart-compatible JSON to stdout")

    p_nb = sub.add_parser("neighbors", help="direct edges for a node")
    p_nb.add_argument("id")
    p_nb.add_argument("--direction", choices=["in", "out", "both"], default="both")

    p_path = sub.add_parser("path", help="shortest path between two nodes")
    p_path.add_argument("a")
    p_path.add_argument("b")

    p_imp = sub.add_parser("impact", help="reverse-transitive dependents of a node")
    p_imp.add_argument("id")

    p_dead = sub.add_parser("dead-nodes", help="nodes nothing references")
    p_dead.add_argument("--kind", default="plugin")

    p_sug = sub.add_parser("suggested-connections", help="one-way reference pairs")
    p_sug.add_argument("--limit", type=int, default=20)

    sub.add_parser("overlaps", help="overlap pairs (behavioral evidence ranks first)")

    p_drift = sub.add_parser("drift", help="declared vs observed coupling, both directions")
    p_drift.add_argument("--limit", type=int, default=50)

    p_import = sub.add_parser("portfolio-import", help="validate or apply a private manifest or archive")
    p_import.add_argument("manifest")
    p_import.add_argument("--portfolio-db")
    p_import.add_argument("--expected-revision", type=int)
    p_import.add_argument("--dry-run", action="store_true")

    p_export = sub.add_parser("portfolio-export", help="write a private recovery archive to stdout")
    p_export.add_argument("--portfolio-db")

    p_convert = sub.add_parser("portfolio-convert", help="propose a private manifest from a Markdown inventory")
    p_convert.add_argument("inventory")
    p_convert.add_argument("--observed-at", required=True)
    p_convert.add_argument("--sidecar")
    p_convert.add_argument("--output-manifest", required=True)
    p_convert.add_argument("--output-sidecar", required=True)

    args = ap.parse_args()
    if args.cmd.startswith("portfolio-"):
        return portfolio_command(args)
    con = store.connect(args.db)

    if args.cmd == "ingest":
        root = Path(args.root).resolve() if args.root else ingest.INTERVERSE
        counts = ingest.ingest(root, con)
        out = {"ok": True, "root": str(root), "counts": counts}
        if not args.no_behavior:
            out["behavior"] = behavior.ingest_behavior(con)
        if not args.no_code:
            out["code"] = code.ingest_code(con, root)
        print(json.dumps(out, indent=2))
        return 0

    out = {
        "stats": lambda: store.stats(con),
        "export": lambda: export.export(con),
        "neighbors": lambda: store.neighbors(con, args.id, args.direction),
        "path": lambda: store.path(con, args.a, args.b),
        "impact": lambda: store.impact(con, args.id),
        "dead-nodes": lambda: store.dead_nodes(con, args.kind),
        "suggested-connections": lambda: store.suggested_connections(con, args.limit),
        "overlaps": lambda: export.compute_overlaps(con),
        "drift": lambda: store.drift(con, args.limit),
    }[args.cmd]()
    print(json.dumps(out, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
