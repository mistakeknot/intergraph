#!/usr/bin/env python3
"""intergraph CLI — ingest / query / export the Sylveste ecosystem graph."""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from intergraph import behavior, code, export, ingest, store  # noqa: E402


def main() -> int:
    ap = argparse.ArgumentParser(prog="intergraph")
    ap.add_argument("--db", help="SQLite db path (default: data/intergraph.db)")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p_ing = sub.add_parser("ingest", help="rebuild graph from interverse manifests")
    p_ing.add_argument("--root", help="interverse root (default: auto-detect)")
    p_ing.add_argument("--no-behavior", action="store_true",
                       help="skip session-history behavioral scan")
    p_ing.add_argument("--no-code", action="store_true",
                       help="skip code-level cross-plugin scan")

    sub.add_parser("stats", help="node/edge counts")
    sub.add_parser("export", help="interchart-compatible JSON to stdout")

    p_nb = sub.add_parser("neighbors", help="direct edges for a node")
    p_nb.add_argument("id")
    p_nb.add_argument("--direction", choices=["in", "out", "both"], default="both")

    p_path = sub.add_parser("path", help="shortest path between two nodes")
    p_path.add_argument("a")
    p_path.add_argument("b")

    p_imp = sub.add_parser("impact", help="reverse-transitive dependents of a node")
    p_imp.add_argument("id")

    p_dead = sub.add_parser("dead-nodes", help="nodes nothing references")
    p_dead.add_argument("--kind", default="plugin")

    p_sug = sub.add_parser("suggested-connections", help="one-way reference pairs")
    p_sug.add_argument("--limit", type=int, default=20)

    sub.add_parser("overlaps", help="overlap pairs (behavioral evidence ranks first)")

    p_drift = sub.add_parser("drift", help="declared vs observed coupling, both directions")
    p_drift.add_argument("--limit", type=int, default=50)

    for command in ('portfolio-import', 'portfolio-export'):
        parser = sub.add_parser(command, help='explicit private portfolio transport')
        parser.add_argument('--portfolio-db', help='durable portfolio file (separate from ecosystem)')
        if command == 'portfolio-import':
            parser.add_argument('manifest', help='versioned manifest or lossless JSON archive')
            parser.add_argument('--dry-run', action='store_true')
            parser.add_argument('--expected-revision', type=int)
    conv = sub.add_parser('portfolio-convert', help='prepare private reviewable manifest; never imports')
    conv.add_argument('inventory')
    conv.add_argument('--observed-at', required=True, help='ISO 8601 timestamp with timezone')
    conv.add_argument('--sidecar', help='previous private identity sidecar (read only)')
    conv.add_argument('--output-manifest', required=True)
    conv.add_argument('--output-sidecar', required=True, help='new sidecar; retain only after accepted import')
    args = ap.parse_args()
    if args.cmd.startswith('portfolio-'):
        from contextlib import closing
        from intergraph import portfolio
        import sqlite3
        try:
            if args.db:
                raise portfolio.PortfolioError('use --portfolio-db, not legacy --db')
            if args.cmd == 'portfolio-convert':
                import os
                from intergraph.portfolio_convert import convert
                prior = portfolio.loads(Path(args.sidecar).read_text()) if args.sidecar else None
                manifest, sidecar, report = convert(Path(args.inventory).read_text(), args.observed_at, prior)
                outputs = [(Path(args.output_manifest), manifest), (Path(args.output_sidecar), sidecar)]
                if any(path.exists() or path.is_symlink() for path, _ in outputs) or outputs[0][0].resolve() == outputs[1][0].resolve():
                    raise portfolio.PortfolioError('conversion outputs must be distinct new private files')
                for path, value in outputs:
                    fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
                    with os.fdopen(fd, 'w') as stream:
                        stream.write(json.dumps(value, indent=2))
                print(json.dumps(report, indent=2))
                return 0
            path = args.portfolio_db or portfolio.default_path()
            if args.cmd == 'portfolio-import':
                document = portfolio.loads(Path(args.manifest).read_text())
                out = portfolio.import_document(path, document, args.expected_revision, args.dry_run)
            else:
                with closing(portfolio.open_readonly(path)) as con:
                    out = portfolio.export_archive(con)
            print(json.dumps(out, indent=2))
            return 0
        except (ValueError, TypeError, KeyError, OSError, sqlite3.DatabaseError) as e:
            # Never echo input data, SQL values, or private file paths in errors.
            print(str(e) if isinstance(e, portfolio.PortfolioError) else 'portfolio operation unavailable', file=sys.stderr)
            return 2
    con = store.connect(args.db)

    if args.cmd == "ingest":
        root = Path(args.root).resolve() if args.root else ingest.INTERVERSE
        counts = ingest.ingest(root, con)
        out = {"ok": True, "root": str(root), "counts": counts}
        if not args.no_behavior:
            out["behavior"] = behavior.ingest_behavior(con)
        if not args.no_code:
            out["code"] = code.ingest_code(con, root)
        print(json.dumps(out, indent=2))
        return 0

    out = {
        "stats": lambda: store.stats(con),
        "export": lambda: export.export(con),
        "neighbors": lambda: store.neighbors(con, args.id, args.direction),
        "path": lambda: store.path(con, args.a, args.b),
        "impact": lambda: store.impact(con, args.id),
        "dead-nodes": lambda: store.dead_nodes(con, args.kind),
        "suggested-connections": lambda: store.suggested_connections(con, args.limit),
        "overlaps": lambda: export.compute_overlaps(con),
        "drift": lambda: store.drift(con, args.limit),
    }[args.cmd]()
    print(json.dumps(out, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
